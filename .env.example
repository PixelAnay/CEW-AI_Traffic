# ==============================================================================
# SmartFlow Server Configuration
# ==============================================================================

# Port to bind HTTP server (default: 8080)
PORT=8080

# Host to bind (0.0.0.0 listens on all interfaces so NodeMCU can connect)
HOST=0.0.0.0

# LLM Base URL (LM Studio, Ollama, LocalAI, vLLM, or OpenAI-compatible endpoint)
# Examples:
#   LM Studio: http://127.0.0.1:1234
#   Ollama:    http://127.0.0.1:11434
#   OpenAI:    https://api.openai.com
AI_PROVIDER_URL=http://127.0.0.1:1234

# AI Model Identifier
# Examples:
#   LM Studio: google/gemma-3-4b, meta-llama-3.1-8b-instruct, qwen2.5-coder-7b-instruct
#   Ollama:    llama3.2, mistral, gemma2:2b
#   OpenAI:    gpt-4o-mini
AI_MODEL=google/gemma-3-4b

# Optional API Key (leave empty for local LM Studio / Ollama without auth)
AI_API_KEY=

# Minimum cooldown between automatic AI optimizations (in milliseconds)
AI_MIN_GAP_MS=6000
